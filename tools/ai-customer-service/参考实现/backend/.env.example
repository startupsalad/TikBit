# ===== AI 在线客服机器人 · 后端配置模板 =====
# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交/分发。
# 由创业沙拉 TikBit 出品 · https://startupsalad.com
#
# 架构说明：后端用 spawn 调容器内的 claude CLI，下面两个 ANTHROPIC_ 变量会传进容器，
# claude CLI 自动读取用于鉴权。所以密钥填这里、由 CLI 消费，后端代码本身不碰。

# --- 必填：tikbit 中转站接入（claude CLI 读取）---
# 接口地址：创业沙拉 tikbit 中转站（国内直连、免梯子、兼容 Claude API）
ANTHROPIC_BASE_URL=https://tikbit.ai
# 你的 tikbit 令牌：去 https://tikbit.ai/ 后台「令牌管理」添加并复制。绝不外发/提交。
ANTHROPIC_AUTH_TOKEN=

# --- 可选（有默认值）---
PORT=8770
# 模型用 claude CLI 短名：haiku（快、便宜，默认）/ sonnet / opus
CLAUDE_MODEL=haiku
# 客服名称（写进系统提示词）
BOT_NAME=智能客服助手
# 问答接口路径（前端 data-api 去掉 Nginx 前缀后 = 此值）
API_PATH=/ask
# 单次提问字数上限
MAX_Q_LEN=500
# 单次回答超时（毫秒）
TIMEOUT_MS=60000
# 同时最多并发几个问答（挡洪水）
MAX_INFLIGHT=3
# 限流：单 IP 每分钟 / 每天最多问几次
IP_PER_MIN=5
IP_PER_DAY=20
# 全站每日算力预算封顶（美元），到顶降级为兜底话术，防刷爆
DAILY_BUDGET_USD=2.0
# 服务忙/连不上时的兜底话术（换成你的联系方式）
FALLBACK_MSG=咨询暂时有点忙，请稍后再试，或通过页面上的联系方式找我们。

